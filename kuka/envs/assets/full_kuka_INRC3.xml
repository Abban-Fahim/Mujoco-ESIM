<?xml version="1.0" ?>

<mujoco>
  <compiler angle="radian" coordinate="local" meshdir="meshes/"/>

  <option>
    <flag gravity="enable"/>
  </option>

  <default> 
    <joint damping="0.5"/>   
    <default class="visual">
      <geom contype="0" conaffinity="0"/>
    </default>
    <default class="collision">
      <geom contype="1" conaffinity="1" friction=".6 0.005 0.0001"/>
    </default>
    <site rgba="1 0 0 .5"/>
  </default>  

  <asset>
    <include file="kuka/kuka_assets.xml"/>
  </asset>

  <worldbody>
  <light pos="0 0 1000" castshadow="false"/>
    <body name="robot" pos="0 0 0">
      <include file="kuka/kuka_mesh_collision_peg_ee.xml"/>
    </body>
    <body name="table" pos="0 0 0">
      <geom class="collision" type="box" size=".41 .63 .5" pos="0 0.37 -0.5" rgba="0.6 0.6 0.6 0"/>
      <geom class="visual" pos="0 0 -1" euler="-1.570796326794897 0 0" type="mesh" mesh="table_mesh" material="kuka_grey"/>
      <geom pos="-0.15 0.6 0" euler="0 0 0" type="mesh" mesh="simple_shapes_mesh"/>
      <geom pos="0.15 0.6 0" euler="0 0 0" type="mesh" mesh="industrial_sockets_mesh"/>
    </body>
    <body name="floor" pos="0 0 -1">
      <geom class="collision" type="plane" size="10 10 1" rgba="0.6 0.6 0.6 1.0"/> 
    </body>
    <site name="des_pose" pos="0 0 0.0" euler="0 0 0" size="0.005, 0.005, 0.005"/>
  </worldbody>

  <actuator>
    <include file="kuka/kuka_actuators.xml"/>
  </actuator>

</mujoco>
